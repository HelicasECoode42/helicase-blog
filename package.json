{
  "name": "helicase-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && astro dev",
    "new:post": "node scripts/new-post.mjs",
    "studio:api": "node scripts/studio-server.mjs",
    "publish:captures": "node scripts/publish-captures.mjs",
    "publish:profile": "node scripts/publish-profile.mjs",
    "sync:activity": "node scripts/sync-activity.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "verify": "npm run check:content && npm run prepare:assets && astro build && node scripts/validate-build.mjs",
    "build": "npm run prepare:assets && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "astro": "^6.4.8",
    "marked": "^15.0.12",
    "sharp": "^0.34.5",
    "three": "^0.184.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/three": "^0.185.1",
    "typescript": "5.7.3"
  }
}
