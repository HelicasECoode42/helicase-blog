---
// ============================================
// HELICASE — CD Player Full Page (/music)
// CD machine center-top, arc of covers around,
// ◀▶ arrow cycling, lyrics main area,
// compact tracklist on right.
// ============================================
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_PLAYLIST } from '../lib/cdPlayer/musicData';

const tracks = DEFAULT_PLAYLIST;
---

<BaseLayout title="Music" description="CD Player — HelicasE">
  <div class="music-page">
    <h1 class="sr-only">MUSIC</h1>
    <a href="/" class="music-back">← canvas</a>

    <!-- Player zone: CD machine + arc + arrows -->
    <div class="music-player-head">
      <!-- CD Machine: Three.js 3D -->
      <div class="music-machine-wrap" id="music-machine">
        <div id="music-3d" style="width:280px;height:200px"></div>
        <div class="music-np" id="music-np">
          <span class="music-np-dot"></span>
          <span id="music-np-title">{tracks[0].title}</span>
        </div>
        <div class="music-controls">
          <button id="music-play" class="music-play" disabled>source required</button>
          <span id="music-time" class="music-time">0:00 / 0:00</span>
        </div>
        <input id="music-seek" class="music-seek" type="range" min="0" max="100" value="0" disabled aria-label="Playback progress" />
        <audio id="music-audio" preload="metadata"></audio>
      </div>

      <!-- Arc with arrows -->
      <div class="music-zone" id="music-zone">
        <button class="music-arrow music-arrow--left" id="music-prev" aria-label="Previous">◀</button>
        <div class="music-arc-wrap">
          <div class="music-arc" id="music-arc">
            {tracks.map((track, i) => (
              <div
                class={`music-cover ${i === 0 ? 'music-cover--active' : ''}`}
                data-idx={i}
                style={`--arc-idx: ${i}; --arc-total: ${tracks.length}`}
              >
                <img src={track.cover} alt={track.title} loading="lazy" />
                {track.favorited && <span class="music-fav-dot"></span>}
              </div>
            ))}
          </div>
        </div>
        <button class="music-arrow music-arrow--right" id="music-next" aria-label="Next">▶</button>
      </div>
    </div>

    <!-- Main content: Lyrics + Tracklist -->
    <div class="music-main">
      <!-- Lyrics area (most of the space) -->
      <div class="music-lyrics" id="music-lyrics">
        <div class="music-lyrics-placeholder">
          <span class="music-lyrics-line">— ♪ —</span>
          <span class="music-lyrics-line">lyrics coming soon</span>
          <span class="music-lyrics-line">click covers to switch tracks</span>
        </div>
      </div>

      <!-- Tracklist (right side, compact) -->
      <div class="music-tracklist" id="music-tracklist">
        <div class="music-list-header">
          <h3 class="music-list-title">TRACKS</h3>
          <button class="music-shuffle-btn" id="music-shuffle" title="shuffle">🔀</button>
          <button class="music-add-btn" id="music-add-btn">+ add</button>
        </div>
        <div id="music-tracklist-inner">
          {tracks.map((track, i) => (
            <div
              class={`music-track ${i === 0 ? 'music-track--current' : ''}`}
              data-idx={i}
            >
              <span class="music-track-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="music-track-info">
                <span class="music-track-title">{track.title}</span>
                <span class="music-track-artist">{track.artist}</span>
              </span>
              {track.favorited && <span class="music-track-heart">♥</span>}
              <a href={track.link} target="_blank" rel="noopener" class="music-track-ext">↗</a>
              <button class="music-track-del" data-idx={i} title="remove">×</button>
            </div>
          ))}
        </div>
      </div>

      <!-- Add track form (hidden by default) -->
      <div class="music-add-form" id="music-add-form" style="display:none">
        <input type="text" id="mf-title" placeholder="title" maxlength="80" />
        <input type="text" id="mf-artist" placeholder="artist" maxlength="80" />
        <input type="text" id="mf-cover" placeholder="cover url" />
        <input type="url" id="mf-audio" placeholder="audio url (.mp3 / .ogg / .m4a)" />
        <input type="text" id="mf-link" placeholder="link url" />
        <div class="music-add-form-btns">
          <button id="mf-save">save</button>
          <button id="mf-cancel">cancel</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .music-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  .music-back {
    font-family: var(--font-mono);
    font-size: 0.75rem; color: var(--color-silver);
    letter-spacing: 0.08em;
    transition: color var(--duration-micro);
    margin-bottom: 30px;
    display: inline-block;
  }
  .music-back:hover { color: var(--color-blue); }

  /* ── Player Head: CD + arc unified ── */
  .music-player-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-bottom: 24px;
  }

  /* ── Player Zone: arc + arrows ────── */
  .music-zone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 0;
  }

  .music-arrow {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-silver);
    background: none;
    border: 1px solid var(--color-silver-light);
    width: 36px; height: 36px;
    cursor: pointer;
    transition: all var(--duration-micro);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .music-arrow:hover {
    color: var(--color-blue);
    border-color: var(--color-blue);
  }

  /* ── Arc ──────────────────────────── */
  .music-arc-wrap {
    position: relative;
    width: 500px;
    height: 100px;
  }

  .music-arc {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .music-cover {
    position: absolute;
    width: 64px; height: 64px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.5s var(--ease-mechanical);
    opacity: 0.55;
  }

  .music-cover img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .music-cover--active {
    border-color: var(--color-blue);
    opacity: 1;
    transform: scale(1.1) !important;
    z-index: 3 !important;
  }

  .music-cover:hover {
    border-color: var(--color-blue);
    opacity: 0.85;
  }

  .music-fav-dot {
    position: absolute; top: -4px; right: -4px;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-blue);
  }

  /* ── CD Machine Container ──────────── */
  .music-machine-wrap{display:flex;flex-direction:column;align-items:center;margin-bottom:0;transition:transform .5s var(--ease-mechanical);}
  .music-machine-wrap.raised{transform:translateY(-24px);}
  .music-np{display:flex;align-items:center;gap:5px;font-family:var(--font-body);font-size:.75rem;font-weight:500;color:var(--color-silver);max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4px;}
  .music-np-dot{width:4px;height:4px;border-radius:50%;background:var(--color-nuclear);flex-shrink:0;}
  .music-controls{display:flex;align-items:center;gap:10px;margin-top:10px;font-family:var(--font-mono)}
  .music-play{min-width:116px;padding:6px 10px;background:none;font:10px var(--font-mono);color:var(--color-black);cursor:pointer}
  .music-play:disabled{color:var(--color-silver);cursor:not-allowed}
  .music-time{font-size:10px;color:var(--color-silver);min-width:76px}
  .music-seek{width:202px;accent-color:var(--color-blue)}

  /* ── Main: Lyrics + Tracklist ─────── */
  .music-main {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .music-lyrics {
    flex: 1;
    min-height: 280px;
    background: var(--color-canvas);
    border: 1px solid var(--color-silver-light);
    padding: 32px;
    display: flex; align-items: center; justify-content: center;
  }

  .music-lyrics-placeholder {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--color-silver);
    letter-spacing: 0.08em;
  }

  /* ── Tracklist ────────────────────── */
  .music-tracklist {
    width: 200px;
    flex-shrink: 0;
  }

  .music-list-header {
    display: flex; align-items: baseline; gap: 8px;
    margin-bottom: 12px;
  }

  .music-list-title {
    font-family: var(--font-mono); font-size: 0.6rem;
    color: var(--color-blue); letter-spacing: 0.15em;
    margin-right: auto;
  }

  .music-shuffle-btn {
    font-size: 0.55rem; color: var(--color-silver);
    background: none; border: 1px solid var(--color-silver-light);
    width: 22px; height: 22px; cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
    transition: all var(--duration-micro);
  }
  .music-shuffle-btn:hover { color: var(--color-blue); border-color: var(--color-blue); }

  .music-add-btn {
    font-family: var(--font-mono); font-size: 0.55rem;
    color: var(--color-silver); background: none;
    border: 1px solid var(--color-silver-light);
    padding: 3px 8px; cursor: pointer; letter-spacing: 0.04em;
    transition: all var(--duration-micro);
  }
  .music-add-btn:hover { color: var(--color-blue); border-color: var(--color-blue); }

  .music-track-del {
    color: var(--color-silver-light); background: none; border: none;
    cursor: pointer; font-family: var(--font-mono); font-size: 0.6rem;
    padding: 0 2px; opacity: 0; transition: all var(--duration-micro);
  }
  .music-track:hover .music-track-del { opacity: 1; }
  .music-track-del:hover { color: #c44; }

  /* Add form */
  .music-add-form {
    margin-top: 12px; display: flex; flex-direction: column; gap: 6px;
    font-family: var(--font-mono);
  }
  .music-add-form input {
    font: 400 0.6rem/1 var(--font-mono);
    background: var(--color-white); border: 1px solid var(--color-silver-light);
    padding: 5px 8px; color: var(--color-black); outline: none;
  }
  .music-add-form input:focus { border-color: var(--color-blue); }
  .music-add-form-btns { display: flex; gap: 6px; }
  .music-add-form-btns button {
    font: 400 0.6rem/1 var(--font-mono); background: none;
    border: 1px solid var(--color-silver); padding: 4px 10px;
    cursor: pointer; color: var(--color-black); letter-spacing: 0.04em;
    transition: all var(--duration-micro);
  }
  #mf-save:hover { border-color: var(--color-blue); color: var(--color-blue); }
  #mf-cancel:hover { color: var(--color-silver); }

  .music-track {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 0;
    border-bottom: 1px solid var(--color-silver-light);
    font-family: var(--font-mono); font-size: 0.7rem;
    color: var(--color-black);
    cursor: pointer;
    transition: color var(--duration-micro), opacity var(--duration-micro);
  }

  .music-track:hover { color: var(--color-blue); }
  .music-track--current { color: var(--color-blue); }

  .music-track-num {
    width: 18px; color: var(--color-silver); font-size: 0.6rem; flex-shrink: 0;
  }

  .music-track-info {
    flex: 1; display: flex; flex-direction: column; gap: 1px;
    min-width: 0;
  }

  .music-track-title {
    font-family: var(--font-body); font-weight: 500;
    font-size: 0.78rem; letter-spacing: -.01em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .music-track-artist {
    font-family: var(--font-body);
    font-size: 0.65rem; color: var(--color-silver);
  }

  .music-track-heart {
    color: var(--color-blue); font-size: 0.6rem; flex-shrink: 0;
  }

  .music-track-ext {
    color: var(--color-silver); font-size: 0.6rem; flex-shrink: 0;
    opacity: 0; transition: opacity var(--duration-micro);
  }

  .music-track:hover .music-track-ext { opacity: 1; }

  /* ── Mobile ───────────────────────── */
  @media (max-width: 767px) {
    .music-arc-wrap { width: 100%; height: 70px; }
    .music-cover { width: 44px; height: 44px; }
    .music-chassis { width: 160px; height: 130px; }
    .music-window { width: 90px; height: 90px; }
    .music-disc { width: 76px; height: 76px; }
    .music-main { flex-direction: column; }
    .music-tracklist { width: 100%; }
    .music-lyrics { min-height: 160px; padding: 20px; }
    .music-page { padding: 24px 12px 60px; }
  }

  @keyframes disc-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
</style>

<script is:inline src="/musicpage.js"></script>

<script>
  // Defer Three.js initialization so page content renders first
  function initCDPlayer() {
    import('../lib/cdPlayer/scene3d').then(({ createCDPlayer }) => {
      const container = document.getElementById('music-3d');
      if (container) (window as Window & { __musicPlayer3D?: unknown }).__musicPlayer3D = createCDPlayer(container, { width:280, height:200, coverUrl:'/images/covers/track-01.svg' });
    }).catch(() => {
      const container = document.getElementById('music-3d');
      if (container) container.setAttribute('data-3d-unavailable', 'true');
    });
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initCDPlayer, { timeout: 1500 });
  } else {
    setTimeout(initCDPlayer, 800);
  }
</script>
