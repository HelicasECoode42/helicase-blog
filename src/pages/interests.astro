---
import BaseLayout from '../layouts/BaseLayout.astro';
const items=[{href:'/music',name:'MUSIC',desc:'正在循环的声音与私人播放列表'},{href:'/favorites',name:'FAVORITES',desc:'动画、书籍、电影、游戏与短评'},{href:'/zine',name:'ZINE',desc:'被选择、编排并留下来的摄影作品'},{href:'/mood',name:'MOODBOARD',desc:'视觉参考、材质与审美方向'}];
---
<BaseLayout title="Interests" description="音乐、影像、收藏与审美索引"><main class="interests"><a href="/">← canvas</a><header><span>INTERESTS</span><h1>INTERESTS</h1></header><div>{items.map((item,i)=><a class="item" href={item.href}><b>{String(i+1).padStart(2,'0')}</b><h2>{item.name}</h2><p>{item.desc}</p><em>↗</em></a>)}</div></main></BaseLayout>
<style>.interests{max-width:900px;margin:auto;padding:56px 24px 100px}.interests>a,header span,.item b{font:10px var(--font-mono);color:var(--color-silver)}header{margin:48px 0 36px}header span{color:var(--color-blue);letter-spacing:.18em}h1{font:700 1rem/1 var(--font-mono);letter-spacing:.2em;color:var(--color-deep-blue);margin:10px 0}.item{display:grid;grid-template-columns:45px 180px 1fr auto;align-items:center;gap:20px;border-top:1px solid var(--color-silver-light);padding:24px 0}.item h2{font:600 1.1rem var(--font-mono);color:var(--color-deep-blue)}.item p{font-size:.85rem;color:var(--color-text-secondary)}.item em{font-style:normal;color:var(--color-blue)}@media(max-width:600px){.interests{padding:40px 16px}.item{grid-template-columns:30px 1fr auto}.item p{grid-column:2/-1}}</style>
