---
// ============================================
// HELICASE — Moodboard Full Page (/mood)
// Pinterest-style masonry image wall.
// ============================================
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mood" description="灵感板 — HelicasE">
  <div class="mood-page public-readonly">
    <h1 class="sr-only">MOODBOARD</h1>
    <a href="/" class="mood-back">← canvas</a>
    <div class="mood-top">
      <h2 class="mood-heading">MOODBOARD</h2>
      <div class="mood-add-wrap" aria-hidden="true">
        <input type="text" id="mood-add-url" class="mood-add-input" placeholder="image url…" />
        <button id="mood-add-save" class="mood-add-save">add</button>
      </div>
    </div>
    <div class="mood-grid" id="mood-grid"></div>
  </div>
</BaseLayout>

<style is:global>
  .mood-page { max-width: 900px; margin: 0 auto; padding: 48px 24px 80px; }
  .mood-back { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-silver); letter-spacing: 0.08em; transition: color var(--duration-micro); margin-bottom: 28px; display: inline-block; }
  .mood-back:hover { color: var(--color-blue); }
  .mood-top { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; }
  .mood-heading { font: 600 0.8rem/1 var(--font-mono); color: var(--color-blue); letter-spacing: 0.15em; }
  .mood-add-wrap { display: flex; gap: 8px; flex: 1; }
  .mood-add-input { flex: 1; font: 400 0.75rem/1 var(--font-mono); border: none; border-bottom: 1px solid var(--color-silver-light); padding: 4px 0; background: none; outline: none; color: var(--color-black); }
  .mood-add-input:focus { border-bottom-color: var(--color-blue); }
  .mood-add-input::placeholder { color: var(--color-silver-light); }
  .mood-add-save { font: 400 0.7rem/1 var(--font-mono); background: none; border: 1px solid var(--color-silver); padding: 5px 14px; cursor: pointer; color: var(--color-black); letter-spacing: 0.05em; transition: all var(--duration-micro); }
  .mood-add-save:hover { border-color: var(--color-blue); color: var(--color-blue); }
  .mood-page.public-readonly .mood-add-wrap,
  .mood-page.public-readonly .mood-img-del { display: none !important; }

  .mood-grid { columns: 4; column-gap: 12px; }
  .mood-img { break-inside: avoid; margin-bottom: 12px; position: relative; cursor: pointer; }
  .mood-img img { width: 100%; display: block; }
  .mood-img:hover { opacity: 0.85; }
  .mood-img-del { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; background: rgba(15,17,23,0.45); color: var(--color-white); font-size: 0.7rem; display: flex; align-items: center; justify-content: center; opacity: 0; cursor: pointer; transition: opacity var(--duration-micro); border: none; }
  .mood-img:hover .mood-img-del { opacity: 1; }
  .mood-img-del:hover { background: rgba(200,0,0,0.6); }
  .mood-empty { text-align: center; font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-silver-light); padding: 60px 0; letter-spacing: 0.05em; }

  @media (max-width: 767px) { .mood-grid { columns: 2; } .mood-top { flex-direction: column; align-items: flex-start; } .mood-add-wrap { width: 100%; } }
</style>

<script>
  const grid = document.getElementById('mood-grid')!;
  type MoodItem = { id: string; image: string; alt?: string };

  async function render() {
    try {
      const res = await fetch('/api/content/mood');
      if (!res.ok) throw new Error();
      const { items } = await res.json() as { items: MoodItem[] };
      if (!items.length) { grid.innerHTML = '<div class="mood-empty">no images yet</div>'; return; }
      grid.innerHTML = items.map(item => `
      <div class="mood-img">
        <img src="${item.image.replace(/"/g,'&quot;')}" alt="${(item.alt || '').replace(/"/g,'&quot;')}" loading="lazy" />
      </div>
      `).join('');
    } catch { grid.innerHTML = '<div class="mood-empty">moodboard is waking up…</div>'; }
  }
  render();
  document.addEventListener('astro:after-swap', () => { if (document.getElementById('mood-grid')) render(); });
</script>
