---
import BaseLayout from '../layouts/BaseLayout.astro';
import inspirations from '../data/inspirations';
---
<BaseLayout title="Inspiration" description="灵感、视觉参考与尚未长成作品的想法">
  <main class="inspo"><a href="/" class="back">← canvas</a><header><span>INSPIRATION INDEX</span><h1>Things worth keeping.</h1><p>这里不是待办列表，而是可能长成文章、项目、图像或世界观的种子。</p></header><div class="grid">{inspirations.map((item,i)=><article><b>{String(i+1).padStart(2,'0')}</b><span>{item.kind}</span><h2>{item.title}</h2><p>{item.note}</p><div>{item.tags.map(t=><em>#{t}</em>)}</div><time>{item.date}</time></article>)}</div><a class="mood" href="/mood">visual moodboard →</a></main>
</BaseLayout>
<style>
  .inspo{max-width:960px;margin:auto;padding:56px 24px 100px}.back{font:12px var(--font-mono);color:var(--color-silver)}header{margin:48px 0 56px;max-width:650px}header span,article>b,article>span,article em,time{font-family:var(--font-mono)}header span{font-size:10px;letter-spacing:.18em;color:var(--color-blue)}h1{font:700 clamp(2.3rem,7vw,5rem)/1 var(--font-body);letter-spacing:-.05em;margin:14px 0;color:var(--color-deep-blue)}header p{line-height:1.8;color:var(--color-text-secondary)}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--color-silver-light);border:1px solid var(--color-silver-light)}article{background:var(--color-canvas);padding:24px;min-height:260px;display:flex;flex-direction:column}article>b,article>span{font-size:9px;color:var(--color-silver)}article>span{margin-left:auto;margin-top:-10px;color:var(--color-blue)}h2{font:600 1.25rem var(--font-body);margin:32px 0 12px}article p{font-size:.9rem;line-height:1.7;flex:1}article em{font-size:9px;font-style:normal;color:var(--color-blue);margin-right:8px}time{font-size:9px;color:var(--color-silver);margin-top:22px}.mood{display:inline-block;margin-top:32px;font:11px var(--font-mono);color:var(--color-blue)}@media(max-width:600px){.inspo{padding:40px 16px}.grid{grid-template-columns:1fr}}
</style>
