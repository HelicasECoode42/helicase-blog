---
import { getCollection } from 'astro:content';
import siteConfig from '../data/site-config.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryLoading from '../components/EntryLoading.astro';
import BackgroundDebris from '../components/BackgroundDebris.astro';
import Profile from '../components/modules/Profile.astro';
import TimeRing from '../components/modules/TimeRing.astro';
import MusicPlayer from '../components/modules/MusicPlayer.astro';
import PhotoZineEntry from '../components/modules/PhotoZineEntry.astro';
import projects from '../data/projects.json';
import { buildActivityFeed } from '../lib/activity-feed';
import { getProjectActivity } from '../lib/project-activity';
import { getRecentRepositories } from '../lib/repository-activity';

const catEntries = await Promise.all(
  siteConfig.categories.map(async (cat) => {
    const posts = (await getCollection('blog', ({ data }) =>
      data.category === cat.key && !data.draft
    )).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    return { ...cat, posts };
  })
);
const activityFeed = buildActivityFeed(catEntries.flatMap(category => category.posts));
const recentPosts = catEntries
  .flatMap(category => category.posts)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const recentRepositories = getRecentRepositories(5);
const activeProjects = projects.filter(project => project.status === 'active' && project.visibility === 'public');
const focusProject = activeProjects.find(project => project.id === 'echoforge') || activeProjects[0];
const supportingProjects = activeProjects.filter(project => project.id !== focusProject?.id).slice(0, 2);
---

<BaseLayout title="Canvas" description="HelicasE — 一张无边线索画布，信息以几何秩序分布。">
  <EntryLoading slot="entry-overlay" />
  <BackgroundDebris />

  <div class="homepage" data-ark-theme="exa" data-ark-depth="complex" data-ark-mode="launcher">
    <h1 class="sr-only">HELICASE personal canvas</h1>
    <!-- ── Identity ───────────────────────── -->
    <section class="hero">
      <div class="hero-profile">
        <Profile />
      </div>
      <div class="hero-player">
        <MusicPlayer title="迷星叫" source="/audio/mi-xing-jiao.mp3" />
        {activityFeed[0] && (
          <a
            class="latest-log"
            href="/now"
            data-activity-date={activityFeed[0].date}
            data-activity-title={activityFeed[0].title}
          >LAST TRACE / {activityFeed[0].date.slice(5)} →</a>
        )}
      </div>
      <div class="hero-creative">
        <div class="hero-timering"><TimeRing /></div>
        <a class="oc-signal" href="/oc" aria-label="Enter OC space">
          <img src="/images/oc/host-idle.gif" alt="" width="128" height="128" />
          <span>HOST_00 →</span>
        </a>
      </div>
    </section>

    <!-- ── Content ────────────────────────── -->
    <section class="portfolio-grid">
      <div class="work-column" aria-labelledby="work-heading">
        <header class="section-heading">
          <div><span>01 / CURRENT PRACTICE</span><h2 id="work-heading">WORK</h2></div>
          <a href="/projects">all projects →</a>
        </header>

        {focusProject && (() => { const activity = getProjectActivity(focusProject); return (
          <a class="featured-work" href={`/projects/${focusProject.id}`}>
            <span class="featured-work-state">FOCUS · {focusProject.phase}</span>
            <strong>{focusProject.name}</strong>
            <p>{focusProject.summary}</p>
            <div>
              <span>{focusProject.current}</span>
              <em data-project-activity={focusProject.githubRepos.length > 0 ? JSON.stringify(activity.activitySeries) : undefined}>
                {focusProject.githubRepos.length > 0 ? <><output data-project-days="7">{activity.last7Days}</output> actions / 7d</> : focusProject.phase}
              </em>
            </div>
          </a>
        )})()}

        <div class="supporting-work">
          {supportingProjects.map(project => { const activity = getProjectActivity(project); return (
            <a href={`/projects/${project.id}`}>
              <span>{project.phase}</span>
              <strong>{project.name}</strong>
              <p>{project.current}</p>
              {project.githubRepos.length > 0 && <em data-project-activity={JSON.stringify(activity.activitySeries)}><output data-project-days="7">{activity.last7Days}</output> / 7d</em>}
            </a>
          )})}
        </div>

        <a class="interests-entry" href="/interests">
          <span>02 / OFF THE CLOCK</span>
          <strong>INTERESTS</strong>
          <p>favorites · zine · mood</p>
          <em>explore →</em>
        </a>
      </div>

      <div class="writings-column" aria-labelledby="writings-heading">
        <header class="section-heading">
          <div><span>03 / PUBLISHED NOTES</span><h2 id="writings-heading">WRITINGS</h2></div>
          <a href="/blog">all writings →</a>
        </header>

        {recentPosts[0] && (
          <a class="featured-writing" href={`/blog/${recentPosts[0].id.replace(/\//g, '-')}`}>
            <span>{recentPosts[0].data.category} · {recentPosts[0].data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}</span>
            <strong>{recentPosts[0].data.title}</strong>
            <p>{recentPosts[0].data.summary}</p>
            <em>READ NOTE →</em>
          </a>
        )}

        <ol class="writing-list">
          {recentPosts.slice(1).map((post, index) => (
            <li>
              <a href={`/blog/${post.id.replace(/\//g, '-')}`}>
                <span>{String(index + 2).padStart(2, '0')}</span>
                <strong>{post.data.title}</strong>
                <em>{post.data.category}</em>
                <time>{post.data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}</time>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="evidence-row" aria-labelledby="recent-repositories-heading">
      <header class="repo-head">
        <div><span>GITHUB EVIDENCE</span><h2 id="recent-repositories-heading">RECENT REPOSITORIES</h2></div>
        <small>LAST 30 DAYS · BY COMMITS</small>
      </header>
      <ol>
        {recentRepositories.map((repository, index) => (
          <li><a href={repository.url}><span>{String(index + 1).padStart(2, '0')}</span><strong>{repository.label}</strong><em>{repository.commits} commits</em></a></li>
        ))}
      </ol>
      <div class="footer-entries">
        <a href="/mood" class="footer-entry-link">[ mood → ]</a>
        <a href="/links" class="footer-entry-link">[ links → ]</a>
        <PhotoZineEntry />
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .homepage {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-bottom: 80px;
  }

  /* ── Hero Section ─────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(180px, 0.7fr) minmax(320px, 1.35fr) auto;
    align-items: flex-start;
    gap: 42px;
    padding-top: 24px;
  }

  .hero-profile {
    flex: 0 0 auto;
  }

  .hero-creative {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .repo-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-silver-light);
  }
  .repo-head span { font-size: .6rem; letter-spacing: .15em; color: var(--color-blue); font-weight: 600; }
  .repo-head small { font-size: .52rem; color: var(--color-silver); letter-spacing: .08em; }

  .hero-timering {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .oc-signal {
    width: 128px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    color: var(--color-silver);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
  }
  .oc-signal img { width: 128px; height: 128px; object-fit: contain; opacity: 0.9; }
  .oc-signal:hover { color: var(--color-blue); }

  /* ── Content Grid ─────────────────────── */
  .content-grid {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .content-articles {
    min-width: 0;
  }

  .articles-clusters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  .articles-clusters > :global(.cluster-module + .cluster-module) { margin-top: 0; }

  .articles-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 28px;
    padding-bottom: 10px;
    border-bottom: 0.5px solid var(--color-silver-light);
  }

  .articles-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-blue);
    letter-spacing: 0.15em;
  }

  .articles-all {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-silver);
    letter-spacing: 0.08em;
    transition: color var(--duration-micro);
  }
  .articles-all:hover { color: var(--color-blue); }

  .articles-note {
    font: 400 0.6rem/1 var(--font-mono);
    color: var(--color-silver-light);
    letter-spacing: 0.06em;
  }

  .content-support {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 48px;
    align-items: start;
    padding-top: 24px;
    border-top: 0.5px solid var(--color-silver-light);
  }

  .content-ideas {
    padding-top: 4px;
  }

  .now-module { font-family: var(--font-mono); }
  .now-module-head { display:flex;justify-content:space-between;border-bottom:1px solid var(--color-silver-light);padding-bottom:7px;margin-bottom:8px; }
  .now-module-head span { font-size:.65rem;letter-spacing:.15em;color:var(--color-blue);font-weight:600; }
  .now-module-head a { font-size:.55rem;color:var(--color-silver); }
  .now-project { display:grid;grid-template-columns:1fr auto;gap:4px;padding:10px 0;border-bottom:1px solid var(--color-silver-light); }
  .now-project strong { font-size:.68rem; }
  .now-project span { grid-column:1/-1;font:400 .68rem/1.5 var(--font-body);color:var(--color-text-secondary); }
  .now-project em { grid-column:2;grid-row:1;font-size:.65rem;font-style:normal;color:var(--color-silver); }
  .repo-module { min-width: 0; font-family: var(--font-mono); }
  .repo-module ol { list-style: none; padding: 0; margin: 0; }
  .repo-module li { border-bottom: 1px solid var(--color-silver-light); }
  .repo-module a { display: block; padding: 9px 0; }
  .repo-module strong { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: .62rem; font-weight: 500; }
  .repo-module a:hover strong { color: var(--color-blue); }
  .repo-module li span { display: block; margin-top: 3px; color: var(--color-silver); font-size: .5rem; }
  .interests-entry { min-width:270px;display:flex;flex-direction:column;gap:8px;font-family:var(--font-mono); }
  .interests-entry span { font-size:.58rem;color:var(--color-blue);letter-spacing:.15em; }
  .interests-entry strong { font-size:.7rem;font-weight:400; }
  .interests-entry em { font-size:.58rem;color:var(--color-silver);font-style:normal; }
  .homepage :global(.profile-edit-badge),
  .homepage :global(.profile-add-link),
  .homepage :global(.profile-inline-form) { display: none !important; }

  .content-cdp {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 4px;
  }

  /* ── Footer Row ───────────────────────── */
  .footer-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 48px;
    padding-top: 16px;
    border-top: 0.5px solid var(--color-silver-light);
  }

  .footer-entries {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .footer-entry-link {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-silver);
    letter-spacing: 0.08em;
    transition: color var(--duration-micro);
  }
  .footer-entry-link:hover { color: var(--color-blue); }

  /* ── Responsive: Tablet (768–1023px) ──── */
  /* Keep the launcher spatial at tablet / narrow desktop widths. Work uses the
     same breakpoint philosophy: only genuinely narrow screens stack the page. */
  @media (min-width: 541px) and (max-width: 1023px) {
    .homepage {
      /* Match the shared work-page frame at the same viewport width. */
      padding-top: 22px;
      padding-inline: 16px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(170px, .72fr) minmax(300px, 1.28fr);
      align-items: center;
      gap: 24px;
    }

    .hero-profile { grid-column: 1; }
    .hero-player { grid-column: 2; max-width: none; }
    .hero-creative { grid-column: 1 / -1; justify-content: center; gap: 24px; }

    .articles-clusters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .content-support { grid-template-columns: minmax(0, 1fr) 200px; }
  }

  /* ── Responsive: Mobile (<541px) ──────── */
  @media (max-width: 540px) {
    .homepage {
      padding: 0 16px;
      gap: 32px;
    }

    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding-top: 8px;
    }

    .hero-creative {
      gap: 16px;
    }

    .hero :global(.signal-instrument) { order: 3; width: 100%; padding-top: 2px; }

    .articles-header { align-items: center; flex-wrap: wrap; }
    .articles-note { display: none; }
    .articles-clusters { grid-template-columns: 1fr; gap: 28px; }
    .content-support { grid-template-columns: 1fr; gap: 28px; }

    .content-grid {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .footer-row {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
  }

  /* ── Responsive: Large desktop (1440px+) ─ */
  @media (min-width: 1440px) {
    .homepage {
      max-width: 1360px;
    }

    .articles-clusters { gap: 56px; }
    .content-support { grid-template-columns: minmax(0, 1fr) 260px; gap: 64px; }
  }
</style>

<style>
  /* 2026-08 information hierarchy: work and writing own the page; repository data stays evidence. */
  .portfolio-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, .92fr);
    gap: clamp(44px, 7vw, 88px);
    align-items: start;
    padding-top: 28px;
    border-top: 1px solid var(--color-deep-blue);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-silver-light);
    font-family: var(--font-mono);
  }
  .section-heading span {
    display: block;
    margin-bottom: 7px;
    font-size: .62rem;
    letter-spacing: .16em;
    color: var(--color-silver);
  }
  .section-heading h2 {
    font: 650 clamp(1.1rem, 2vw, 1.55rem)/.9 var(--font-mono);
    letter-spacing: .13em;
    color: var(--color-deep-blue);
  }
  .section-heading a {
    padding-bottom: 2px;
    font-size: .65rem;
    color: var(--color-silver);
    white-space: nowrap;
  }
  .section-heading a:hover { color: var(--color-blue); }

  .featured-work {
    position: relative;
    display: block;
    min-height: 245px;
    padding: 22px 24px 20px 27px;
    overflow: hidden;
    border-left: 3px solid var(--color-blue);
    background: linear-gradient(120deg, color-mix(in srgb, var(--color-blue) 5%, transparent), transparent 62%);
  }
  .featured-work::after {
    content: '01';
    position: absolute;
    right: 18px;
    top: 9px;
    font: 500 4.8rem/1 var(--font-mono);
    color: color-mix(in srgb, var(--color-blue) 8%, transparent);
    pointer-events: none;
  }
  .featured-work-state {
    font: 600 .62rem/1 var(--font-mono);
    letter-spacing: .14em;
    color: var(--color-blue);
  }
  .featured-work > strong {
    position: relative;
    display: block;
    margin-top: 34px;
    font: 650 clamp(1.65rem, 3vw, 2.35rem)/1 var(--font-body);
    color: var(--color-deep-blue);
  }
  .featured-work > p {
    position: relative;
    max-width: 540px;
    margin-top: 12px;
    font-size: .82rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .featured-work > div {
    position: absolute;
    left: 27px;
    right: 22px;
    bottom: 17px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 10px;
    border-top: 1px solid var(--color-silver-light);
    font-family: var(--font-mono);
  }
  .featured-work > div span {
    overflow: hidden;
    font-size: .66rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .featured-work > div em {
    flex: none;
    font-size: .62rem;
    font-style: normal;
    color: var(--color-silver);
  }
  .featured-work:hover > strong { color: var(--color-blue); }

  .supporting-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1px;
    background: var(--color-silver-light);
  }
  .supporting-work a {
    position: relative;
    min-height: 128px;
    padding: 15px 16px;
    background: var(--color-canvas);
  }
  .supporting-work span,
  .supporting-work em {
    font: .6rem/1 var(--font-mono);
    letter-spacing: .1em;
    color: var(--color-silver);
    font-style: normal;
  }
  .supporting-work strong { display: block; margin-top: 14px; font: 600 .88rem/1.1 var(--font-body); }
  .supporting-work p { margin-top: 8px; font-size: .72rem; line-height: 1.5; color: var(--color-text-secondary); }
  .supporting-work em { position: absolute; right: 14px; bottom: 12px; }
  .supporting-work a:hover strong { color: var(--color-blue); }

  .interests-entry {
    position: relative;
    min-width: 0;
    margin-top: 28px;
    padding: 18px 112px 18px 0;
    gap: 5px;
    border-top: 1px solid var(--color-deep-blue);
    border-bottom: 1px solid var(--color-silver-light);
  }
  .interests-entry span { font-size: .6rem; color: var(--color-silver); }
  .interests-entry strong { margin-top: 8px; font-size: .95rem; font-weight: 650; letter-spacing: .12em; color: var(--color-deep-blue); }
  .interests-entry p { font-size: .72rem; color: var(--color-text-secondary); }
  .interests-entry em { position: absolute; right: 0; bottom: 20px; color: var(--color-blue); }

  .featured-writing {
    display: block;
    padding: 22px 0 26px;
    border-bottom: 1px solid var(--color-deep-blue);
  }
  .featured-writing > span,
  .featured-writing > em {
    font: 500 .62rem/1 var(--font-mono);
    letter-spacing: .12em;
    color: var(--color-blue);
    text-transform: uppercase;
    font-style: normal;
  }
  .featured-writing > strong {
    display: block;
    max-width: 520px;
    margin-top: 19px;
    font: 650 clamp(1.12rem, 2vw, 1.55rem)/1.24 var(--font-body);
    color: var(--color-deep-blue);
  }
  .featured-writing > p {
    margin: 15px 0 24px;
    font-size: .8rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }
  .featured-writing:hover > strong { color: var(--color-blue); }

  .writing-list { list-style: none; margin: 0; padding: 0; }
  .writing-list li { border-bottom: 1px solid var(--color-silver-light); }
  .writing-list a {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto auto;
    gap: 12px;
    align-items: baseline;
    padding: 14px 0;
    font-family: var(--font-mono);
  }
  .writing-list span,
  .writing-list em,
  .writing-list time { font-size: .6rem; color: var(--color-silver); font-style: normal; text-transform: uppercase; }
  .writing-list span { color: var(--color-blue); }
  .writing-list strong { overflow: hidden; font-size: .72rem; font-weight: 500; white-space: nowrap; text-overflow: ellipsis; }
  .writing-list a:hover strong { color: var(--color-blue); }

  .evidence-row {
    padding-top: 22px;
    border-top: 1px solid var(--color-silver-light);
    font-family: var(--font-mono);
  }
  .evidence-row .repo-head { align-items: flex-end; border-bottom: 0; }
  .repo-head div > span { display: block; margin-bottom: 5px; color: var(--color-silver); font-size: .6rem; }
  .repo-head h2 { font: 600 .68rem/1 var(--font-mono); letter-spacing: .14em; color: var(--color-blue); }
  .evidence-row > ol {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    margin: 13px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-silver-light);
  }
  .evidence-row > ol li { min-width: 0; border-right: 1px solid var(--color-silver-light); }
  .evidence-row > ol li:last-child { border-right: 0; }
  .evidence-row > ol a { display: grid; gap: 6px; min-height: 88px; padding: 12px; }
  .evidence-row > ol span,
  .evidence-row > ol em { font-size: .6rem; color: var(--color-silver); font-style: normal; }
  .evidence-row > ol span { color: var(--color-blue); }
  .evidence-row > ol strong { overflow: hidden; font-size: .7rem; font-weight: 500; white-space: nowrap; text-overflow: ellipsis; }
  .evidence-row > ol a:hover strong { color: var(--color-blue); }
  .evidence-row .footer-entries { justify-content: flex-end; margin-top: 28px; }

  @media (max-width: 1023px) and (min-width: 768px) {
    .hero { grid-template-columns: 170px minmax(0, 1fr); }
    .hero :global(.signal-instrument) { grid-column: 1 / -1; grid-row: 2; max-width: 560px; margin-left: 0; }
    .portfolio-grid { gap: 42px; }
  }

  @media (max-width: 767px) {
    .hero :global(.signal-instrument) { width: calc(100% - 12px); max-width: 560px; margin-right: auto; margin-left: 0; }
