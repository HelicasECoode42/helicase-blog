---
import BaseLayout from '../layouts/BaseLayout.astro';
import projects from '../data/projects';
import activities from '../data/activities';
---
<BaseLayout title="Studio" description="HELICASE 本地工作台" noindex>
  <main class="studio">
    <header><div><span>LOCAL CONTROL SURFACE</span><h1>STUDIO</h1></div><div id="api-state" class="offline">checking local api…</div></header>
    <section class="summary"><div><strong>{projects.filter(p=>p.status==='active').length}</strong><span>active projects</span></div><div><strong id="capture-count">0</strong><span>inbox captures</span></div><div><strong>{activities.length}</strong><span>public activities</span></div></section>
    <section class="capture"><div class="section-head"><h2>QUICK CAPTURE</h2><span>⌘/Ctrl + Enter to save</span></div><div class="capture-types" id="capture-types">{[['progress','项目进展'],['idea','灵感'],['learning','学习记录'],['image','图片'],['article','新文章']].map(([type,label],i)=><button class:list={{active:i===0}} data-type={type}>{label}</button>)}</div><textarea id="capture-text" maxlength="1000" placeholder="记录刚刚发生的事，不用先整理…"></textarea><div class="capture-actions"><span id="capture-feedback">仅写入本机 .helicase 数据</span><button id="capture-save">capture →</button></div></section>
    <section class="profile-config"><div class="section-head"><h2>PROFILE</h2><span>local draft</span></div><div class="profile-fields"><input id="sp-name" maxlength="48" placeholder="name" /><input id="sp-avatar" placeholder="avatar url or /images/..." /><input id="sp-bio" maxlength="140" placeholder="signature" /><textarea id="sp-socials" maxlength="500" placeholder="github https://github.com/you&#10;site https://example.com"></textarea></div><div class="capture-actions"><span id="profile-feedback">save locally, then run npm run publish:profile</span><button id="profile-save">save profile →</button></div></section>
    <div class="columns"><section><h2>ACTIVE PROJECTS</h2><div class="projects">{projects.filter(p=>p.status==='active').map(p=><a href={`/projects#${p.id}`}><div><strong>{p.name}</strong><span>{p.current}</span></div><em>{p.progress}%</em><small>next: {p.next}</small></a>)}</div></section><section><h2>INBOX</h2><div id="capture-list" class="inbox"><p>Start the local API to load captures.</p></div></section></div>
    <footer><a href="/projects">public projects ↗</a><a href="/now">activity ↗</a><a href="/mood">mood ↗</a><a href="/editor">markdown editor ↗</a></footer>
  </main>
</BaseLayout>
<script>
  // @ts-nocheck -- local-only control surface; API validates every persisted value.
  const API='http://127.0.0.1:4177';
  const stateEl=document.getElementById('api-state'); const countEl=document.getElementById('capture-count'); const listEl=document.getElementById('capture-list'); const textEl=document.getElementById('capture-text'); const feedback=document.getElementById('capture-feedback');
  let type='progress';
  function escapeText(value){const span=document.createElement('span');span.textContent=value;return span.innerHTML}
  function render(state){const inbox=state.captures.filter(c=>c.status!=='published');countEl.textContent=String(inbox.length);listEl.innerHTML=inbox.length?inbox.slice(0,8).map(c=>`<article><span>${escapeText(c.type)} · ${escapeText(c.status)}</span><p>${escapeText(c.text)}</p><time>${new Date(c.createdAt).toLocaleString('zh-CN')}</time><button data-approve="${escapeText(c.id)}">${c.status==='approved'?'approved ✓':'approve for public'}</button></article>`).join(''):'<p>Inbox is clear.</p>'}
  async function load(){try{const res=await fetch(`${API}/api/state`);if(!res.ok)throw new Error();render(await res.json());stateEl.textContent='local api connected';stateEl.className='online'}catch{stateEl.textContent='local api offline · run npm run studio:api';stateEl.className='offline'}}
  document.getElementById('capture-types').addEventListener('click',e=>{const btn=e.target.closest('button');if(!btn)return;type=btn.dataset.type;document.querySelectorAll('.capture-types button').forEach(b=>b.classList.toggle('active',b===btn));textEl.focus()});
  async function save(){const text=textEl.value.trim();if(!text)return;feedback.textContent='saving…';try{const res=await fetch(`${API}/api/capture`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type,text})});if(!res.ok)throw new Error();render(await res.json());textEl.value='';feedback.textContent='captured locally'}catch{feedback.textContent='local API unavailable · run npm run studio:api'}}
  document.getElementById('capture-save').addEventListener('click',save);textEl.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key==='Enter'){e.preventDefault();save()}});load();
  listEl.addEventListener('click',async e=>{const button=e.target.closest('[data-approve]');if(!button)return;try{const res=await fetch(`${API}/api/capture/status`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:button.dataset.approve,status:'approved'})});if(!res.ok)throw new Error();render(await res.json());feedback.textContent='approved · run npm run publish:captures'}catch{feedback.textContent='could not update capture'}});
  const profileFeedback=document.getElementById('profile-feedback'),profileInputs={name:document.getElementById('sp-name'),avatar:document.getElementById('sp-avatar'),bio:document.getElementById('sp-bio'),socials:document.getElementById('sp-socials')};
  async function loadProfile(){try{const res=await fetch(`${API}/api/state`);const state=await res.json(),p=state.profile;if(!p)return;profileInputs.name.value=p.name||'';profileInputs.avatar.value=p.avatar||'';profileInputs.bio.value=p.bio||'';profileInputs.socials.value=(p.socials||[]).map(s=>`${s.label} ${s.url}`).join('\n')}catch{}}
  document.getElementById('profile-save').addEventListener('click',async()=>{const socials=profileInputs.socials.value.split('\n').map(line=>{const i=line.indexOf(' ');return i>0?{label:line.slice(0,i),url:line.slice(i+1).trim()}:null}).filter(Boolean);try{const res=await fetch(`${API}/api/profile`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:profileInputs.name.value,bio:profileInputs.bio.value,avatar:profileInputs.avatar.value,socials})});if(!res.ok)throw new Error();profileFeedback.textContent='saved · run npm run publish:profile'}catch{profileFeedback.textContent='could not save profile'}});loadProfile();
</script>
<style>
  .studio{max-width:1100px;margin:auto;padding:48px 24px 100px}header{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--color-silver-light);padding-bottom:18px}header span,h2,.section-head span,#api-state,.summary span,.capture-actions,footer{font-family:var(--font-mono)}header span{font-size:9px;letter-spacing:.18em;color:var(--color-blue)}h1{font:700 2.5rem var(--font-mono);letter-spacing:-.06em}.online,.offline{font-size:9px;padding:5px 8px;border:1px solid}.online{color:#208050}.offline{color:#ad5b36}.summary{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--color-silver-light)}.summary div{padding:24px 0}.summary strong{font:500 2rem var(--font-mono);display:block}.summary span{font-size:9px;color:var(--color-silver)}section{margin-top:38px}h2{font-size:10px;letter-spacing:.16em;color:var(--color-blue)}.section-head{display:flex;justify-content:space-between}.section-head span{font-size:9px;color:var(--color-silver)}.capture-types{display:flex;gap:5px;margin:14px 0}.capture-types button{background:none;padding:7px 10px;font:10px var(--font-mono);cursor:pointer}.capture-types button.active{background:var(--color-blue);color:white;border-color:var(--color-blue)}textarea{width:100%;min-height:120px;padding:16px;background:transparent;resize:vertical;font:14px/1.7 var(--font-mono);outline:none}textarea:focus{border-color:var(--color-blue)}.capture-actions{display:flex;justify-content:space-between;align-items:center;margin-top:8px;font-size:9px;color:var(--color-silver)}.capture-actions button{background:var(--color-blue);color:white;padding:8px 16px;cursor:pointer}.profile-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}.profile-fields input,.profile-fields textarea{width:100%;padding:9px;background:transparent;font:12px var(--font-mono);outline:none}.profile-fields textarea{grid-column:1/-1;min-height:70px}.columns{display:grid;grid-template-columns:1fr 1fr;gap:45px}.projects a{display:grid;grid-template-columns:1fr auto;gap:5px;padding:15px 0;border-bottom:1px solid var(--color-silver-light)}.projects strong,.projects span,.projects small{display:block}.projects span,.projects small{font-size:.78rem;color:var(--color-text-secondary);margin-top:4px}.projects em{font:normal 1.2rem var(--font-mono);color:var(--color-silver)}.projects small{grid-column:1/-1;font-family:var(--font-mono);color:var(--color-blue)}.inbox article{padding:12px 0;border-bottom:1px solid var(--color-silver-light)}.inbox article span,.inbox time{font:9px var(--font-mono);color:var(--color-blue)}.inbox article p{font-size:.85rem;margin:6px 0}.inbox time{color:var(--color-silver)}.inbox article button{display:block;margin-top:7px;background:none;padding:4px 7px;font:9px var(--font-mono);color:var(--color-blue);cursor:pointer}.inbox>p{font-size:.8rem;color:var(--color-silver);margin-top:16px}footer{display:flex;gap:22px;flex-wrap:wrap;margin-top:60px;border-top:1px solid var(--color-silver-light);padding-top:20px;font-size:10px;color:var(--color-blue)}@media(max-width:700px){.studio{padding:32px 14px}.columns{grid-template-columns:1fr}.profile-fields{grid-template-columns:1fr}.summary strong{font-size:1.5rem}.capture-types{overflow-x:auto}header{align-items:start;gap:15px}}
</style>
