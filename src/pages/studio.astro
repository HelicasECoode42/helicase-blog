---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import links from '../data/links.json';
import projects from '../data/projects.json';
const siteSettingDefaults = { profile, links, projects };
---
<BaseLayout title="Studio" description="HELICASE 私人控制台" noindex>
  <main class="studio">
    <div id="site-setting-defaults" data-json={JSON.stringify(siteSettingDefaults)} hidden></div>
    <header><div><span>PRIVATE CONTROL SURFACE</span><h1>STUDIO</h1></div><a href="/">← public canvas</a></header>
    <p class="intro">Favorites / Mood / Zine 保存到 D1 后立即公开；Profile / Links / Projects 先存私有草稿，只有 Publish 后才进入 Git 和公开构建。图片请先使用可公开访问的 URL。</p>
    <section><h2>FAVORITES / MOOD / ZINE</h2><div class="tabs"><button data-kind="favorites" class="active">favorite</button><button data-kind="mood">mood</button><button data-kind="zine">zine</button></div><div id="favorite-search" class="favorite-search"><input id="favorite-query" placeholder="搜索 Bangumi：如 孤独摇滚、塞尔达…" /><button id="favorite-find">search →</button><div id="favorite-results" class="search-results"></div><div id="favorite-compose" hidden><strong id="favorite-picked"></strong><label>rating <input id="favorite-rating" type="number" min="0" max="10" value="8" /></label><textarea id="favorite-note" placeholder="你的短评 / 备注…" maxlength="500"></textarea><button id="favorite-add">add to favorites →</button></div></div><textarea id="content-json" spellcheck="false"></textarea><div class="actions"><span id="content-status">Favorites 请用上方搜索；Mood/Zine 可填入 JSON 保存。</span><button id="content-save">save item →</button></div><div id="content-list" class="list"></div></section>
    <section><h2>ARTICLES</h2><p class="hint">在 Editor 写作并点击 publish。这里会列出 GitHub 主分支的文章；标记为 draft 的文章不会出现在公开 Daily/Blog。</p><div class="actions"><span id="article-status">loading…</span><a class="button-link" href="/editor">open editor →</a><button id="article-refresh">refresh →</button></div><div id="article-list" class="list"></div></section>
    <section><h2>COMMENT MODERATION</h2><div id="comments" class="list">loading…</div></section>
    <section><h2>PROFILE / LINKS / PROJECTS</h2><p class="hint">Save Draft 使用 revision 防止覆盖其他窗口的修改；Publish 会验证草稿并提交对应 JSON 到 GitHub。刷新页面后仍会从 D1 恢复 Published / Waiting / Live 状态。</p><div class="tabs"><button data-setting="profile" class="active">profile</button><button data-setting="links">links</button><button data-setting="projects">projects</button></div><textarea id="setting-json" spellcheck="false" placeholder='{"avatar":"/images/avatar.jpg","name":"HELICASE","bio":"…","socials":[]}'></textarea><div class="actions"><span id="setting-status">private draft not loaded</span><div class="action-buttons"><button id="setting-reload">reload →</button><button id="setting-save">save draft →</button><button id="setting-publish" disabled>publish →</button></div></div><div id="deployment-status" class="deployment-status" hidden></div></section>
  </main>
</BaseLayout>
<script>
  type Item = Record<string, unknown> & { id: string };
  let kind = 'favorites', setting = 'profile', editingId = '', settingDraftHash = '', settingRevision = 0;
  let publishedCommitSha = '', publishedHash = '', deploymentTimer = 0;
  const content = document.getElementById('content-json') as HTMLTextAreaElement, contentStatus = document.getElementById('content-status')!, list = document.getElementById('content-list')!;
  const settingText = document.getElementById('setting-json') as HTMLTextAreaElement, settingStatus = document.getElementById('setting-status')!;
  const siteDefaults = JSON.parse((document.getElementById('site-setting-defaults') as HTMLElement).dataset.json || '{}') as Record<string, unknown>;
  const samples: Record<string, string> = { favorites: '{"bgmId":1,"name":"title","name_cn":"中文名","cover":"https://…","type":2,"typeLabel":"动画","rating":8,"note":"…"}', mood: '{"image":"https://…","alt":"optional description"}', zine: '{"image":"https://…","title":"optional title","caption":"optional caption"}' };
  const labels: Record<number, string> = {1:'书籍',2:'动画',3:'音乐',4:'游戏',6:'电影'};
  let selectedFavorite: Record<string, unknown> | null = null;
  function appendTextElement(parent: Element, tag: string, value: unknown, className = '') { const element=document.createElement(tag);element.textContent=String(value??'');if(className)element.className=className;parent.append(element);return element; }
  function safeHttpsUrl(value: unknown) { try { const url=new URL(String(value??''));return url.protocol==='https:'?url.href:''; } catch { return ''; } }
  function emptyMessage(target: Element, message: string) { target.replaceChildren();appendTextElement(target,'p',message); }
  async function loadContent() { content.placeholder = samples[kind]; content.value = ''; editingId = ''; document.getElementById('favorite-search')!.toggleAttribute('hidden', kind !== 'favorites'); list.textContent='loading…'; try { const r=await fetch(`/api/admin/content/${kind}`); const d=await r.json(); if(!r.ok) throw new Error(d.error); const items: Item[]=Array.isArray(d.items)?d.items:[];list.replaceChildren();if(!items.length){emptyMessage(list,'empty');return;}for(const item of items){const article=document.createElement('article');appendTextElement(article,'code',item.id);appendTextElement(article,'p',item.name_cn||item.name||item.title||item.caption||item.image);const edit=appendTextElement(article,'button','edit') as HTMLButtonElement;edit.type='button';edit.addEventListener('click',()=>{editingId=item.id;const {id:_,createdAt:__,updatedAt:___,...payload}=item;content.value=JSON.stringify(payload,null,2);contentStatus.textContent=`editing ${item.id}`;});const remove=appendTextElement(article,'button','delete') as HTMLButtonElement;remove.type='button';remove.addEventListener('click',async()=>{if(!confirm('Delete this public item?'))return;const response=await fetch(`/api/admin/content/${kind}/${encodeURIComponent(item.id)}`,{method:'DELETE',headers:{'Content-Type':'application/json'}});if(!response.ok){contentStatus.textContent='delete failed';return;}contentStatus.textContent='deleted from D1 · public API updated';loadContent();});list.append(article);} } catch(e) { list.textContent=`storage unavailable: ${(e as Error).message}`; } }
  document.querySelectorAll('[data-kind]').forEach(button=>button.addEventListener('click',()=>{kind=(button as HTMLElement).dataset.kind!;document.querySelectorAll('[data-kind]').forEach(b=>b.classList.toggle('active',b===button));loadContent();}));
  async function findFavorites(){const q=(document.getElementById('favorite-query') as HTMLInputElement).value.trim(),out=document.getElementById('favorite-results')!;if(!q)return;out.textContent='searching…';try{const r=await fetch(`https://api.bgm.tv/search/subject/${encodeURIComponent(q)}?responseGroup=small&max_results=12`);const d=await r.json();const items=Array.isArray(d.list)?d.list:[];out.replaceChildren();if(!items.length){out.textContent='no result';return;}for(const x of items){const cover=safeHttpsUrl(x?.images?.common||x?.images?.large);const picked={bgmId:Number(x?.id)||0,name:String(x?.name||''),name_cn:String(x?.name_cn||''),cover,type:Number(x?.type)||0,typeLabel:labels[Number(x?.type)]||'其他'};const button=document.createElement('button');button.type='button';button.dataset.bgm=JSON.stringify(picked);if(cover){const image=document.createElement('img');image.src=cover;image.alt='';image.referrerPolicy='no-referrer';button.append(image);}const label=document.createElement('span');label.textContent=picked.name_cn||picked.name;appendTextElement(label,'small',picked.typeLabel);button.append(label);button.addEventListener('click',()=>{selectedFavorite=picked;document.getElementById('favorite-picked')!.textContent=picked.name_cn||picked.name;document.getElementById('favorite-compose')!.hidden=false;});out.append(button);}}catch{out.textContent='Bangumi search failed; try again later.';}}
  document.getElementById('favorite-find')!.addEventListener('click',findFavorites);document.getElementById('favorite-query')!.addEventListener('keydown',e=>{if(e.key==='Enter')findFavorites()});document.getElementById('favorite-add')!.addEventListener('click',async()=>{if(!selectedFavorite)return;const rating=Number((document.getElementById('favorite-rating') as HTMLInputElement).value),note=(document.getElementById('favorite-note') as HTMLTextAreaElement).value;const r=await fetch('/api/admin/content/favorites',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({item:{...selectedFavorite,rating,note}})});if(!r.ok){contentStatus.textContent='could not save favorite';return;}contentStatus.textContent='saved to D1 · public API updated';selectedFavorite=null;document.getElementById('favorite-compose')!.hidden=true;loadContent();});
  document.getElementById('content-save')!.addEventListener('click',async()=>{try{const item=JSON.parse(content.value);const r=await fetch(`/api/admin/content/${kind}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:editingId||undefined,item})});const d=await r.json();if(!r.ok)throw new Error(d.error);contentStatus.textContent='saved to D1 · public API updated';loadContent();}catch(e){contentStatus.textContent=`could not save: ${(e as Error).message}`;}});
  const settingPublish = document.getElementById('setting-publish') as HTMLButtonElement, deploymentStatus = document.getElementById('deployment-status')!;
  function stopDeploymentPoll(){if(deploymentTimer)window.clearTimeout(deploymentTimer);deploymentTimer=0;}
  function clearPublication(){stopDeploymentPoll();publishedCommitSha='';publishedHash='';deploymentStatus.hidden=true;deploymentStatus.textContent='';deploymentStatus.removeAttribute('data-state');}
  function applyPublication(data: Record<string, any>){stopDeploymentPoll();publishedCommitSha=String(data.publishedCommitSha||data.commitSha||'');publishedHash=String(data.publishedHash||'');if(!publishedHash&&!publishedCommitSha){deploymentStatus.hidden=true;deploymentStatus.textContent='';return;}deploymentStatus.hidden=false;checkDeployment();}
  async function loadSetting(){settingText.value='';settingDraftHash='';settingRevision=0;settingPublish.disabled=true;clearPublication();try{const r=await fetch(`/api/admin/site/${setting}`),d=await r.json();if(!r.ok)throw new Error(d.error);settingRevision=Number(d.revision)||0;if(d.value){settingText.value=JSON.stringify(d.value,null,2);settingDraftHash=d.draftHash||'';settingPublish.disabled=!settingDraftHash;settingStatus.textContent=d.publishedHash===d.draftHash?`published draft r${settingRevision} loaded`:`private draft r${settingRevision} loaded · public site unchanged`;}else{settingText.value=JSON.stringify(siteDefaults[setting]??null,null,2);settingStatus.textContent='loaded current public source · save to create private draft r1';}applyPublication(d);}catch(e){settingStatus.textContent=`storage unavailable: ${(e as Error).message}`;}}
  document.querySelectorAll('[data-setting]').forEach(button=>button.addEventListener('click',()=>{setting=(button as HTMLElement).dataset.setting!;document.querySelectorAll('[data-setting]').forEach(b=>b.classList.toggle('active',b===button));loadSetting();}));
  settingText.addEventListener('input',()=>{settingPublish.disabled=true;settingStatus.textContent=`unsaved changes based on r${settingRevision}`;});
  document.getElementById('setting-reload')!.addEventListener('click',loadSetting);
  document.getElementById('setting-save')!.addEventListener('click',async()=>{try{const value=JSON.parse(settingText.value);settingStatus.textContent=`saving private draft from r${settingRevision}…`;const r=await fetch(`/api/admin/site/${setting}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({value,expectedRevision:settingRevision})});const d=await r.json();if(!r.ok){if(r.status===409){settingDraftHash='';settingPublish.disabled=true;settingStatus.textContent=`save conflict · remote draft is r${d.revision??'?'}; copy changes, then reload`;return;}throw new Error(d.error);}settingRevision=Number(d.revision);settingDraftHash=d.draftHash||'';settingPublish.disabled=!settingDraftHash;settingStatus.textContent=d.publishedHash===settingDraftHash?`draft r${settingRevision} saved · matches published content`:`draft r${settingRevision} saved · public site unchanged`;applyPublication(d);}catch(e){settingDraftHash='';settingPublish.disabled=true;settingStatus.textContent=`could not save: ${(e as Error).message}`;}});
  async function checkDeployment(){stopDeploymentPoll();if(!publishedHash&&!publishedCommitSha)return;const checkedSetting=setting,checkedHash=publishedHash,checkedCommit=publishedCommitSha;try{const r=await fetch(`/build-meta.json?check=${Date.now()}`,{cache:'no-store'}),d=await r.json();if(checkedSetting!==setting||checkedHash!==publishedHash||checkedCommit!==publishedCommitSha)return;const contentLive=d.contentHashes?.[checkedSetting]===checkedHash;const legacyCommitLive=!d.contentHashes&&checkedCommit&&d.commitSha===checkedCommit;if(r.ok&&(contentLive||legacyCommitLive)){deploymentStatus.textContent=`live · ${checkedCommit.slice(0,12)||checkedHash.slice(0,12)}`;deploymentStatus.dataset.state='live';return;}}catch{}if(checkedSetting!==setting||checkedHash!==publishedHash||checkedCommit!==publishedCommitSha)return;deploymentStatus.textContent=`waiting for deployment · ${checkedCommit.slice(0,12)||checkedHash.slice(0,12)}`;deploymentStatus.dataset.state='waiting';deploymentTimer=window.setTimeout(checkDeployment,15000);}
  settingPublish.addEventListener('click',async()=>{if(!settingDraftHash)return;settingPublish.disabled=true;settingStatus.textContent=`publishing draft r${settingRevision} to GitHub…`;try{const r=await fetch(`/api/admin/site/${setting}/publish`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({expectedRevision:settingRevision,expectedDraftHash:settingDraftHash})}),d=await r.json();if(!r.ok){if(r.status===409){settingDraftHash='';settingStatus.textContent=`publish conflict · remote draft is r${d.revision??'?'}; reload required`;return;}throw new Error(d.error);}applyPublication(d);if(d.draftChangedSincePublish){settingDraftHash='';settingRevision=Number(d.revision)||settingRevision;settingStatus.textContent='published to GitHub, but another session saved a newer draft · reload required';}else{settingStatus.textContent=d.alreadyPublished?'already published to GitHub':`published to GitHub · ${String(d.commitSha).slice(0,12)}`;}}catch(e){settingStatus.textContent=`publish failed: ${(e as Error).message}`;}finally{settingPublish.disabled=!settingDraftHash;}});
  async function loadArticles(){const status=document.getElementById('article-status')!,target=document.getElementById('article-list')!;status.textContent='loading…';try{const r=await fetch('/api/admin/articles');const d=await r.json();if(!r.ok)throw new Error(d.error);const items=Array.isArray(d.items)?d.items:[];target.replaceChildren();if(!items.length)emptyMessage(target,'no GitHub articles found');for(const articleData of items){const article=document.createElement('article');appendTextElement(article,'code',articleData.category||'');const description=appendTextElement(article,'p',articleData.title||'');appendTextElement(description,'strong',articleData.draft?' draft — not public':' public');appendTextElement(article,'small',articleData.date||'');target.append(article);}status.textContent=`${items.length} article(s)`;}catch(e){status.textContent=`could not load: ${(e as Error).message}`;}}
  document.getElementById('article-refresh')!.addEventListener('click',loadArticles);loadContent();loadSetting();loadArticles();
</script>
<style>
  .studio{max-width:880px;margin:auto;padding:48px 24px 100px}.studio header{display:flex;justify-content:space-between;border-bottom:1px solid var(--color-silver-light);padding-bottom:16px}.studio header span,h2,.tabs,button,.actions,.hint,.intro,.favorite-search{font-family:var(--font-mono)}h1{margin:7px 0 0;font-size:2.5rem}.studio a{font:10px var(--font-mono);color:var(--color-blue)}.intro,.hint{font-size:.75rem;color:var(--color-silver);line-height:1.7;margin:22px 0}section{margin-top:42px}h2{font-size:10px;letter-spacing:.16em;color:var(--color-blue)}.tabs,.action-buttons{display:flex;gap:7px}.tabs{margin:14px 0}.tabs button,.list button{background:none;padding:6px 9px;cursor:pointer;font-size:10px}.tabs .active{background:var(--color-blue);color:white;border-color:var(--color-blue)}textarea{display:block;width:100%;min-height:145px;background:transparent;padding:12px;font:12px/1.6 var(--font-mono);outline:none;resize:vertical}.actions{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-top:8px;font-size:9px;color:var(--color-silver)}.actions button,.button-link{background:var(--color-blue);color:#fff!important;border:0;padding:9px 13px;cursor:pointer}.actions button:disabled{opacity:.35;cursor:not-allowed}.deployment-status{margin-top:10px;padding:9px 11px;border-left:2px solid var(--color-silver-light);font:10px/1.5 var(--font-mono);color:var(--color-silver)}.deployment-status[data-state="live"]{border-color:#2c8b57;color:#2c8b57}.deployment-status[data-state="waiting"]{border-color:var(--color-blue);color:var(--color-blue)}.list{margin-top:15px}.list article{display:flex;gap:12px;align-items:center;border-bottom:1px solid var(--color-silver-light);padding:10px 0;font:11px var(--font-mono)}.list code{color:var(--color-silver)}.list p{flex:1;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.list button{color:var(--color-blue)}.favorite-search{padding:14px;border:1px solid var(--color-silver-light);margin:14px 0}.favorite-search input{padding:8px;background:transparent;font:12px var(--font-mono);min-width:260px}.favorite-search button{padding:8px;cursor:pointer}.search-results{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.search-results button{display:flex;text-align:left;gap:7px;background:#fff;padding:7px;border:1px solid var(--color-silver-light)}.search-results img{width:34px;height:48px;object-fit:cover}.search-results small{display:block;color:var(--color-silver);margin-top:4px}.favorite-search label{display:block;margin:10px 0;font-size:11px}.favorite-search textarea{min-height:75px}.favorite-search[hidden]{display:none}@media(max-width:600px){.studio{padding:32px 14px}.actions{align-items:flex-start;flex-direction:column}.list article{flex-wrap:wrap}.search-results{grid-template-columns:1fr}.favorite-search input{min-width:0;width:100%}}
</style>
