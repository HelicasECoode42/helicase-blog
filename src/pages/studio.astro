---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Studio" description="HELICASE 私人控制台" noindex>
  <main class="studio">
    <header><div><span>PRIVATE CONTROL SURFACE</span><h1>STUDIO</h1></div><a href="/">← public canvas</a></header>
    <p class="intro">这里的提交直接写入 Cloudflare D1；公开访客没有写权限。图片请先使用可公开访问的 URL。</p>
    <section><h2>FAVORITES / MOOD / ZINE</h2><div class="tabs"><button data-kind="favorites" class="active">favorite</button><button data-kind="mood">mood</button><button data-kind="zine">zine</button></div><textarea id="content-json" spellcheck="false"></textarea><div class="actions"><span id="content-status">填入 JSON 后保存；列表会显示现有条目。</span><button id="content-save">save item →</button></div><div id="content-list" class="list"></div></section>
    <section><h2>COMMENT MODERATION</h2><div id="comments" class="list">loading…</div></section>
    <section><h2>PROFILE / LINKS / PROJECTS</h2><p class="hint">这是 Studio 的结构化草稿库。填写后保存，不会自动改写代码或公开页；公开资料应当经一次明确的发布动作，避免误发。</p><div class="tabs"><button data-setting="profile" class="active">profile</button><button data-setting="links">links</button><button data-setting="projects">projects</button></div><textarea id="setting-json" spellcheck="false" placeholder='{"name":"HELICASE","bio":"…"}'></textarea><div class="actions"><span id="setting-status">保存到私有 Studio 存储。</span><button id="setting-save">save draft →</button></div></section>
  </main>
</BaseLayout>
<script>
  type Item = Record<string, unknown> & { id: string };
  let kind = 'favorites', setting = 'profile', editingId = '';
  const content = document.getElementById('content-json') as HTMLTextAreaElement, contentStatus = document.getElementById('content-status')!, list = document.getElementById('content-list')!;
  const settingText = document.getElementById('setting-json') as HTMLTextAreaElement, settingStatus = document.getElementById('setting-status')!;
  const samples: Record<string, string> = { favorites: '{"bgmId":1,"name":"title","name_cn":"中文名","cover":"https://…","type":2,"typeLabel":"动画","rating":8,"note":"…"}', mood: '{"image":"https://…","alt":"optional description"}', zine: '{"image":"https://…","title":"optional title","caption":"optional caption"}' };
  function esc(v: unknown) { const s=document.createElement('span');s.textContent=String(v ?? '');return s.innerHTML; }
  async function loadContent() { content.placeholder = samples[kind]; content.value = ''; editingId = ''; list.textContent='loading…'; try { const r=await fetch(`/api/admin/content/${kind}`); const d=await r.json(); if(!r.ok) throw new Error(d.error); const items: Item[]=d.items||[]; list.innerHTML=items.length?items.map(item=>`<article><code>${esc(item.id)}</code><p>${esc(item.name_cn||item.name||item.title||item.caption||item.image)}</p><button data-edit="${esc(item.id)}">edit</button><button data-del="${esc(item.id)}">delete</button></article>`).join(''):'<p>empty</p>'; list.querySelectorAll('[data-edit]').forEach(b=>b.addEventListener('click',()=>{const id=(b as HTMLElement).dataset.edit!;const item=items.find(x=>x.id===id)!;editingId=id;const {id:_,createdAt:__,updatedAt:___,...payload}=item;content.value=JSON.stringify(payload,null,2);contentStatus.textContent=`editing ${id}`;})); list.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',async()=>{const id=(b as HTMLElement).dataset.del!; if(!confirm('Delete this public item?'))return; await fetch(`/api/admin/content/${kind}/${id}`,{method:'DELETE'});loadContent();})); } catch(e) { list.textContent=`storage unavailable: ${(e as Error).message}`; } }
  document.querySelectorAll('[data-kind]').forEach(button=>button.addEventListener('click',()=>{kind=(button as HTMLElement).dataset.kind!;document.querySelectorAll('[data-kind]').forEach(b=>b.classList.toggle('active',b===button));loadContent();}));
  document.getElementById('content-save')!.addEventListener('click',async()=>{try{const item=JSON.parse(content.value);const r=await fetch(`/api/admin/content/${kind}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:editingId||undefined,item})});const d=await r.json();if(!r.ok)throw new Error(d.error);contentStatus.textContent='saved';loadContent();}catch(e){contentStatus.textContent=`could not save: ${(e as Error).message}`;}});
  async function loadSetting(){settingText.value='';try{const r=await fetch(`/api/admin/site/${setting}`),d=await r.json();if(!r.ok)throw new Error(d.error);if(d.value)settingText.value=JSON.stringify(d.value,null,2);}catch(e){settingStatus.textContent=`storage unavailable: ${(e as Error).message}`;}}
  document.querySelectorAll('[data-setting]').forEach(button=>button.addEventListener('click',()=>{setting=(button as HTMLElement).dataset.setting!;document.querySelectorAll('[data-setting]').forEach(b=>b.classList.toggle('active',b===button));loadSetting();}));
  document.getElementById('setting-save')!.addEventListener('click',async()=>{try{const value=JSON.parse(settingText.value);const r=await fetch(`/api/admin/site/${setting}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({value})});const d=await r.json();if(!r.ok)throw new Error(d.error);settingStatus.textContent=d.note||'saved';}catch(e){settingStatus.textContent=`could not save: ${(e as Error).message}`;}});
  loadContent();loadSetting();
</script>
<style>
  .studio{max-width:880px;margin:auto;padding:48px 24px 100px}.studio header{display:flex;justify-content:space-between;border-bottom:1px solid var(--color-silver-light);padding-bottom:16px}.studio header span,h2,.tabs,button,.actions,.hint,.intro{font-family:var(--font-mono)}h1{margin:7px 0 0;font-size:2.5rem}.studio a{font:10px var(--font-mono);color:var(--color-blue)}.intro,.hint{font-size:.75rem;color:var(--color-silver);line-height:1.7;margin:22px 0}section{margin-top:42px}h2{font-size:10px;letter-spacing:.16em;color:var(--color-blue)}.tabs{display:flex;gap:7px;margin:14px 0}.tabs button,.list button{background:none;padding:6px 9px;cursor:pointer;font-size:10px}.tabs .active{background:var(--color-blue);color:white;border-color:var(--color-blue)}textarea{display:block;width:100%;min-height:145px;background:transparent;padding:12px;font:12px/1.6 var(--font-mono);outline:none;resize:vertical}.actions{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-top:8px;font-size:9px;color:var(--color-silver)}.actions button{background:var(--color-blue);color:#fff;border:0;padding:9px 13px;cursor:pointer}.list{margin-top:15px}.list article{display:flex;gap:12px;align-items:center;border-bottom:1px solid var(--color-silver-light);padding:10px 0;font:11px var(--font-mono)}.list code{color:var(--color-silver)}.list p{flex:1;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.list button{color:var(--color-blue)}@media(max-width:600px){.studio{padding:32px 14px}.actions{align-items:flex-start;flex-direction:column}.list article{flex-wrap:wrap}}
</style>
