---
// ============================================
// HELICASE — 404 Page
// Clean, on-brand, with navigation.
// ============================================
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Page not found">
  <div class="not-found">
    <div class="nf-code">404</div>
    <p class="nf-text">This thread leads nowhere.</p>
    <a href="/" class="nf-link">← back to canvas</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 120px);
    padding: 40px 24px;
    text-align: center;
  }

  .nf-code {
    font-family: var(--font-mono);
    font-size: 6rem;
    font-weight: 700;
    color: var(--color-silver-light);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 16px;
  }

  .nf-text {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-silver);
    margin-bottom: 32px;
  }

  .nf-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-blue);
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: opacity var(--duration-micro);
  }
  .nf-link:hover { opacity: 0.7; }
</style>
