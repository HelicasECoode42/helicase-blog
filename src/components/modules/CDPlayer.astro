<div class="home-audio" data-module="home-audio">
  <div class="audio-state">
    <span class="audio-dot"></span>
    <span id="home-audio-title">MUSIC</span>
  </div>
  <div class="audio-actions">
    <button id="home-audio-random" type="button">random</button>
    <button id="home-audio-toggle" type="button">play</button>
    <a href="/music">tracks →</a>
  </div>
</div>

<style>
  .home-audio{width:190px;padding-top:4px;font-family:var(--font-mono)}
  .audio-state{display:flex;align-items:center;gap:7px;min-height:28px;border-bottom:1px solid var(--color-silver-light);font-size:.62rem;color:var(--color-silver)}
  .audio-state span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .audio-dot{width:4px;height:4px;border-radius:50%;background:var(--color-blue);flex:0 0 auto}
  .audio-actions{display:flex;align-items:center;gap:7px;padding-top:8px}
  button,.audio-actions a{border:0;background:none;padding:0;font:500 .58rem var(--font-mono);color:var(--color-silver);cursor:pointer}
  button:hover,.audio-actions a:hover{color:var(--color-blue)}
  @media(max-width:767px){.home-audio{width:100%;max-width:260px}}
</style>

<script is:inline src="/home-audio.js"></script>
