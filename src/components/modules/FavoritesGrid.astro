---
// ============================================
// HELICASE — Favorites Grid (Canvas Mini)
// Compact text list: 3-4 items, then "..."
// ============================================
---

<div class="fav-module" data-module="favorites" id="fav-module">
  <h3 class="fav-title">FAVORITES</h3>
  <ul class="fav-list" id="fav-list"></ul>
  <a href="/favorites" class="fav-full-link">[ all → ]</a>
</div>

<style is:global>
  .fav-module {
    font-family: var(--font-mono);
    width: 170px;
  }

  .fav-title {
    font: 600 0.7rem/1 var(--font-mono);
    color: var(--color-blue);
    letter-spacing: 0.15em;
    margin-bottom: 8px;
  }

  .fav-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .fav-item {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--color-black);
    display: flex;
    align-items: baseline;
    gap: 5px;
  }

  .fav-item-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fav-item-type {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.6rem;
    color: var(--color-silver-light);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .fav-item-stars {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-blue);
    letter-spacing: 1.5px;
    flex-shrink: 0;
  }

  .fav-more {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-silver-light);
    letter-spacing: 0.05em;
  }

  .fav-full-link {
    font-size: 0.6rem;
    color: var(--color-silver);
    letter-spacing: 0.08em;
    display: inline-block;
    margin-top: 6px;
    transition: color var(--duration-micro);
  }

  .fav-full-link:hover { color: var(--color-blue); }

  @media (max-width: 767px) {
    .fav-module { width: 100%; }
  }
</style>

<script>
  const STORE = 'helicase-favorites';
  const list = document.getElementById('fav-list')!;

  function esc(s: string) { return s?.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;') || ''; }

  function render() {
    let items: any[] = [];
    try { const r = localStorage.getItem(STORE); if (r) items = JSON.parse(r); } catch {}

    if (!items.length) {
      list.innerHTML = '<li class="fav-item" style="color:var(--color-silver-light);font-size:0.6rem">no items</li>';
      return;
    }

    const latest = items.slice(-4).reverse();
    const show = latest.slice(0, 3);
    const more = latest.length > 3;

    list.innerHTML = show.map((i: any) => `
      <li class="fav-item">
        <span class="fav-item-name">${esc(i.name_cn || i.name)}</span>
        <span class="fav-item-type">${esc(i.typeLabel || '')}</span>
        <span class="fav-item-stars">${'★'.repeat(Math.round(i.rating / 2))}</span>
      </li>
    `).join('')
    + (more ? `<li class="fav-more">… and more</li>` : '');
  }

  render();
  window.addEventListener('storage', (e) => { if (e.key === STORE) render(); });
  // Re-render on View Transition back
  document.addEventListener('astro:after-swap', () => {
    if (document.getElementById('fav-list')) render();
  });
</script>
