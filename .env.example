# Canonical production URL used while Astro builds RSS, sitemap and metadata.
# Set this to the final workers.dev or custom-domain URL in Workers Builds.
SITE_URL=https://helicase-blog.example.workers.dev
# Public Turnstile widget key used by OC, anonymous Zine comments, and link applications.
PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
